# ============================================================
# IoT Rega - Variáveis de Ambiente
# Copia este ficheiro para .env e preenche os valores
# ============================================================

# Servidor
PORT=3000
NODE_ENV=development

# Base de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iotrega
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=muda_este_secret_para_producao_2024
JWT_EXPIRES_IN=7d

# MQTT Broker (Mosquitto local ou HiveMQ cloud)
MQTT_BROKER=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=iotrega-backend

# API Climática (Open-Meteo - gratuita, sem chave)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Simulação IoT
SIMULATE_SENSORS=true
SIMULATE_INTERVAL_MS=10000
